{
    "openapi": "3.0.0",
    "info": {
        "title": "Rashi API Documentation",
        "description": "API documentation for Rashi application",
        "contact": {
            "email": "support@rashi.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/info-videos": {
            "get": {
                "tags": [
                    "Info Videos"
                ],
                "summary": "Get all visible info videos",
                "operationId": "4b7d1d3decdcdb8521498014f658700c",
                "responses": {
                    "200": {
                        "description": "List of visible info videos ordered by rank",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Introduction Video"
                                                    },
                                                    "link": {
                                                        "type": "string",
                                                        "example": "https://youtube.com/watch?v=example"
                                                    },
                                                    "appear": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "appear_status": {
                                                        "type": "string",
                                                        "example": "Appear"
                                                    },
                                                    "media": {
                                                        "type": "array",
                                                        "items": {
                                                            "properties": {
                                                                "id": {
                                                                    "type": "integer",
                                                                    "example": 1
                                                                },
                                                                "url": {
                                                                    "type": "string",
                                                                    "example": "https://example.com/media/video.mp4"
                                                                },
                                                                "name": {
                                                                    "type": "string",
                                                                    "example": "video.mp4"
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/social-media": {
            "get": {
                "tags": [
                    "Social Media"
                ],
                "summary": "Get all social media platforms",
                "operationId": "17902d234ebc2010d6297c8ae1836551",
                "responses": {
                    "200": {
                        "description": "List of social media platforms",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Facebook"
                                                    },
                                                    "link": {
                                                        "type": "string",
                                                        "example": "https://www.facebook.com/example"
                                                    },
                                                    "icon": {
                                                        "type": "string",
                                                        "example": "fab fa-facebook"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Info Videos",
            "description": "Info Videos"
        },
        {
            "name": "Social Media",
            "description": "Social Media"
        }
    ]
}