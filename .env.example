APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# how many minutes a refresh token remains valid (7 days default)
REFRESH_TOKEN_EXPIRATION=10080

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Avarewase SSO client (web admin login) — copy these into your app's .env
# and fill in the values from the client you registered at
# https://auth.avarewase.com/admin/clients (Authorization Code + PKCE, confidential)
AVAREWASE_SSO_BASE_URL=https://auth.avarewase.com
AVAREWASE_SSO_CLIENT_ID=
AVAREWASE_SSO_CLIENT_SECRET=
# Note the "auth/" prefix: rashi's own login/callback routes live under
# routes/web.php's "auth" prefix group, not the package's default
# "login/avarewase" path (routes.enabled is false, see config/avarewase-sso.php).
# Must exactly match the redirect URI registered for this client in the SSO admin.
AVAREWASE_SSO_REDIRECT_URI="${APP_URL}/auth/login/avarewase/callback"
AVAREWASE_SSO_SCOPES="openid profile email"

AVAREWASE_SSO_GUARD=web
AVAREWASE_SSO_USER_MODEL='App\Models\User'

# rashi uses its own admin-gated login/callback controller instead of the
# package's routes — keep this false, see config/avarewase-sso.php
AVAREWASE_SSO_ROUTES_ENABLED=false

AVAREWASE_SSO_HTTP_TIMEOUT=5
AVAREWASE_SSO_HTTP_CONNECT_TIMEOUT=3
AVAREWASE_SSO_HTTP_RETRY_TIMES=2
AVAREWASE_SSO_HTTP_RETRY_SLEEP_MS=200

# Back-channel logout: set this client's "Logout Webhook URL" in the SSO
# admin panel to "${APP_URL}/login/avarewase/logout-webhook", then paste the
# signing secret it reveals (once) into AVAREWASE_SSO_LOGOUT_SECRET below.
AVAREWASE_SSO_LOGOUT_WEBHOOK_ENABLED=true
AVAREWASE_SSO_LOGOUT_SECRET=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
